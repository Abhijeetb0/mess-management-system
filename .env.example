# ─────────────────────────────────────────────────────────
#  .env.example — GEC Mess App Firebase Configuration Template
#
#  1. Go to Firebase Console → Project Settings → Your apps
#  2. Click the web app → SDK setup → Config
#  3. Copy your values and paste them into a new file named `.env.local`
#  4. Set VITE_USE_FIREBASE=true to activate real Firebase
#     (leave unset or false to use mock data in dev)
# ─────────────────────────────────────────────────────────

# Set to "true" to use real Firebase instead of mock data
VITE_USE_FIREBASE=true

# Your Firebase project config (replace with real values in .env.local)
VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-auth-domain-here.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id-here"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id-here.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
